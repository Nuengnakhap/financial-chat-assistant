# Copy to .env and fill in OPENAI_API_KEY. Everything else works as-is against
# the local Docker stack (`pnpm infra:up`).

# --- database ---------------------------------------------------------------
# Runtime connection: DML only, no DDL.
DATABASE_URL=postgresql://app_runtime:runtime_password@localhost:5432/financial_chat
# Schema owner: used by migrations and seeds only.
MIGRATION_DATABASE_URL=postgresql://app:app_password@localhost:5432/financial_chat
# Read-only role used to execute SQL written by the model. SELECT on one table.
FINANCIAL_DB_URL=postgresql://llm_reader:llm_reader_password@localhost:5432/financial_chat

REDIS_URL=redis://localhost:6379

# --- llm --------------------------------------------------------------------
# Any OpenAI-compatible endpoint works; the model must support streaming and tool calling.
# gpt-5.6-luna is the cheapest model in the current line ($0.20 / $1.20 per 1M tokens),
# which is plenty for this workload. Use gpt-5.6-terra if answers need more reasoning.
# For a local endpoint: OPENAI_BASE_URL=http://localhost:11434/v1 with an open-weight
# model that supports tools, e.g. OPENAI_MODEL=gpt-oss:20b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT_MS=60000

# --- usage limits -----------------------------------------------------------
# Spending cap per user, reset on a fixed window. Both are configurable.
# To exercise the limit quickly, try USAGE_LIMIT_USD=0.001 and USAGE_WINDOW_SECONDS=180.
USAGE_LIMIT_USD=1
USAGE_WINDOW_SECONDS=3600

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Refreshing extends a session, but never past this many days from signing in.
SESSION_ABSOLUTE_TTL_DAYS=90
# Two tabs refreshing at once present the same token; the one that loses the race
# is indistinguishable from a stolen copy. Within this window it is treated as a
# race and only that request fails; after it, the whole session lineage is revoked.
REFRESH_REUSE_GRACE_SECONDS=10
# How long a dead session is kept in the database. It leaves every listing the
# moment it is revoked or expires; this only decides how long the row survives
# for anyone reconstructing what happened.
SESSION_RETENTION_DAYS=30

# Sign-in and registration are counted in a sliding window. The two sign-in
# limits differ because an office behind one NAT shares a host but not an
# address, and must not lock itself out. Registering is counted per host only:
# counting it per address would let anyone lock a known account out by
# registering its email over and over.
AUTH_THROTTLE_WINDOW_SECONDS=300
AUTH_THROTTLE_PER_EMAIL=5
AUTH_THROTTLE_PER_IP=20
AUTH_THROTTLE_REGISTRATIONS_PER_IP=10
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- app --------------------------------------------------------------------
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Leave empty to export traces to the console.
OTEL_EXPORTER_OTLP_ENDPOINT=
