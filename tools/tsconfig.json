{
  // Build tooling. Outside the solution build: nothing here is emitted.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["architecture/fixtures/**"]
}
