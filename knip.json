{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tools/**/*.spec.ts"],
      "project": ["scripts/**/*.mjs", "tools/**/*.{ts,mjs}"],
      "ignore": ["tools/architecture/fixtures/**"],
      "ignoreUnresolved": ["src/__tests__/global-setup.ts", "./vitest.setup.ts"]
    },
    "packages/domain": {
      "entry": ["src/index.ts", "src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": ["src/index.ts", "src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts", "src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["index.html", "src/**/*.spec.tsx", "src/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["jsdom"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.ts",
        "src/__tests__/global-setup.ts",
        "worker-threads/*.cjs",
        "src/**/__tests__/*.cjs"
      ],
      "project": ["src/**/*.ts", "worker-threads/*.cjs", "src/**/__tests__/*.cjs"],
      "ignoreDependencies": ["pino-pretty"]
    }
  }
}
