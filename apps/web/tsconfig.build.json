{
  // The `tsc -b` graph. Nothing is emitted — Vite builds the bundle — but the
  // project still takes part so a type error here fails `pnpm build` like any
  // other package. Verified: TypeScript accepts `composite` with `noEmit` and
  // still reports errors; only a .tsbuildinfo is written. `declaration` has to be
  // switched back on, though: tsconfig.json turns it off for the editor, and a
  // composite project that disables declaration emit is TS6304 even when nothing
  // is emitted at all.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
