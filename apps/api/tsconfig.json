{
  // Editor, ESLint and `pnpm typecheck`. Covers tests, so type-aware rules reach them.

  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
