{
  "name": "@fca/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP and streaming API",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fca/config": "workspace:*",
    "@fca/contracts": "workspace:*",
    "@fca/domain": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@node-rs/argon2": "^2.1.0",
    "bullmq": "^6.3.0",
    "drizzle-orm": "0.45.2",
    "fast-jwt": "^6.3.2",
    "fastify": "5.11.3",
    "gpt-tokenizer": "^4.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
